# Python
__pycache__/
*.pyc
*.pyo

# Virtual env
venv/
env/
.venv/
.python-version

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Secrets
.env
.env.*
credentials/
service_account*.json
*.key
*.pem

# Личное
BACKLOG.md

# Data & Cache
cache/*
core/data/*.csv
core/data/*.pkl

# Логи НЕ игнорируем намеренно: без них разбор отказов идёт вслепую — по
# логу прогона 21.09 стало видно, что аварийный путь _normalize_pair_with_cache
# ходит в LLM поштучно. Держать их в репозитории вечно не нужно, см. BACKLOG.

# Config cache
config/__pycache__/
config/*.pyc

# Keep folders
!cache/.gitkeep
!logs/.gitkeep
!credentials/.gitkeep

# Temporarily track .json files in config, cache and logs
!config/*.json
!cache/*.json
!logs/*.json