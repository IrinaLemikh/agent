# Caddy как единственная дверь снаружи: TLS + логин/пароль перед приложением.
#
# СЕЙЧАС сертификат самоподписанный — см. "tls internal" ниже. Браузер при
# заходе ругается на неизвестного издателя, но трафик шифруется полноценно:
# не подтверждена личность сервера, а не защита канала. Так пришлось сделать
# потому, что Let's Encrypt отказал с ошибкой 429: лимит в 50 сертификатов за
# неделю считается на весь домен twc1.net целиком и делится между всеми
# клиентами Timeweb, а не принадлежит нам.
#
# КАК ВЕРНУТЬ НАСТОЯЩИЙ: удалить строку "tls internal" и перезапустить Caddy
# (docker compose restart caddy). Он снова пойдёт в Let's Encrypt, и если в
# общей квоте к тому времени освободится место — выпустит сертификат сам,
# после чего предупреждение в браузере исчезнет. Условия те же, что и всегда:
# домен резолвится в IP этой машины, порты 80 и 443 открыты в фаерволе
# провайдера (80 нужен и после выпуска — по нему идёт продление).
#
# HTTP → HTTPS Caddy редиректит автоматически, отдельного блока не нужно.

6707531-hg304046.twc1.net, agent.6707531-hg304046.twc1.net {
	# Логин/пароль. Сам пароль здесь НЕ хранится — только его bcrypt-хэш,
	# обратно он не расшифровывается. Чтобы сменить пароль, получи новый хэш
	#   docker run --rm caddy:2 caddy hash-password --plaintext 'НОВЫЙ_ПАРОЛЬ'
	# и замени им строку ниже.
	#
	# ВНИМАНИЕ про версию: директива называется basic_auth начиная с Caddy
	# 2.8. Если в логах "unrecognized directive: basic_auth" — образ старше,
	# тогда пиши слитно: basicauth.
	basic_auth {
		slon-e $2a$14$1AeXbAAbjkT7iz.d5tN.Ie8mE6Lq4mweylniC/Pol5aBgQjMaLTYu
	}

	# Сертификат от собственного центра Caddy вместо публичного. Подробности
	# и порядок возврата к Let's Encrypt — в шапке файла.
	tls internal

	# Streamlit живёт на постоянном websocket — Caddy проксирует Upgrade сам,
	# в отличие от nginx, где это пришлось бы прописывать руками. Таймаутов на
	# чтение ответа у reverse_proxy по умолчанию нет, так что многочасовое
	# обновление данных и долгие ответы агента соединение не рвут.
	#
	# agent — имя сервиса из docker-compose, порт внутренний (наружу не торчит).
	reverse_proxy agent:8501
}
